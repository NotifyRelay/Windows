<Page
    x:Class="NotifyRelay.Views.LocalNotificationHistoryPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NotifyRelay.Data.Models"
    xmlns:vm="using:NotifyRelay.ViewModels"
    xmlns:converters="using:NotifyRelay.Converters"
    xmlns:wctconverters="using:CommunityToolkit.WinUI.Converters"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <wctconverters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <wctconverters:BoolToObjectConverter x:Key="BoolToCollapseGlyphConverter" FalseValue="&#xE71D;" TrueValue="&#xE90A;" />

        <converters:DateTimeConverter x:Key="DateTimeConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Inverse="True" />
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />

        <DataTemplate x:Key="LocalNotificationItemTemplate" x:DataType="models:Notification">
            <Grid Padding="10,6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Top"
                    Source="{x:Bind Icon, Mode=OneWay}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="13"
                        FontWeight="Medium"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="Gray"
                        MaxLines="2"
                        Text="{x:Bind Text}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    FontSize="11"
                    Foreground="Gray"
                    VerticalAlignment="Top"
                    Text="{x:Bind TimeStamp, Converter={StaticResource DateTimeConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupedNotificationTemplate" x:DataType="models:GroupedNotification">
            <Border
                Padding="0"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Stretch">
                <ContentControl HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Grid x:Name="SingleNotificationGrid" x:Load="{x:Bind IsSingle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Row="0"
                                Padding="10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="{x:Bind ToggleCollapse}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind Icon, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="14"
                                        FontWeight="Medium"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DisplayApp}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="12"
                                        Foreground="Gray"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind FormattedLatestTime, Mode=OneWay}" />
                                    <FontIcon
                                        Grid.Column="3"
                                        Glyph="{x:Bind IsCollapsed, Converter={StaticResource BoolToCollapseGlyphConverter}, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="4"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ViewModel.ClearGroupCommand, ElementName=PageRoot}"
                                        CommandParameter="{x:Bind AppPackage}"
                                        ToolTipService.ToolTip="清除该应用所有通知">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </Button>
                            <Rectangle
                                Grid.Row="1"
                                Height="1"
                                Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                                Visibility="{x:Bind IsCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" />
                            <ItemsRepeater
                                Grid.Row="2"
                                ItemsSource="{x:Bind Notifications}"
                                ItemTemplate="{StaticResource LocalNotificationItemTemplate}"
                                Visibility="{x:Bind IsCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" />
                        </Grid>

                        <Grid x:Name="MultipleNotificationsGrid" x:Load="{x:Bind IsSingle, Converter={StaticResource BoolNegationConverter}}" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Row="0"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="{x:Bind ToggleCollapse}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <Grid ColumnSpacing="10" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        Margin="10,10,0,10"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind Icon, Mode=OneWay}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="0,10,0,10"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Text="{x:Bind DisplayApp}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="Gray"
                                            Text="{x:Bind NotificationCountText, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,10,10,10"
                                        FontSize="12"
                                        Foreground="Gray"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind FormattedLatestTime, Mode=OneWay}" />
                                    <FontIcon
                                        Grid.Column="3"
                                        Margin="0,10,0,10"
                                        Glyph="{x:Bind IsCollapsed, Converter={StaticResource BoolToCollapseGlyphConverter}, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="4"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ViewModel.ClearGroupCommand, ElementName=PageRoot}"
                                        CommandParameter="{x:Bind AppPackage}"
                                        ToolTipService.ToolTip="清除该应用所有通知">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </Button>

                            <Rectangle
                                Grid.Row="0"
                                Height="1"
                                Margin="0,0,0,0"
                                VerticalAlignment="Bottom"
                                Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                                Visibility="{x:Bind IsCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" />

                            <Button
                                Grid.Row="1"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="{x:Bind ToggleCollapse}"
                                Visibility="{x:Bind IsCollapsed, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <ItemsRepeater ItemsSource="{x:Bind CollapsedNotifications, Mode=OneWay}" HorizontalAlignment="Stretch">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="5" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:Notification">
                                                <Grid ColumnSpacing="10" Margin="10,5,10,0" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="1,0,0,0"
                                                        FontSize="13"
                                                        FontWeight="Medium"
                                                        Text="{x:Bind Title}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="0,0,10,0"
                                                        FontSize="12"
                                                        Foreground="Gray" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="{x:Bind Text}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock
                                        Margin="10,5,10,10"
                                        FontSize="12"
                                        Foreground="Gray"
                                        HorizontalAlignment="Left">
                                        <Run Text="共" />
                                        <Run Text="{x:Bind Notifications.Count, Mode=OneWay}" />
                                        <Run Text="条，点击展开" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <StackPanel
                                Grid.Row="1"
                                Margin="0,0,0,0"
                                Visibility="{x:Bind IsCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                                <ItemsRepeater ItemsSource="{x:Bind Notifications}" HorizontalAlignment="Stretch">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="7" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:Notification">
                                            <StackPanel HorizontalAlignment="Stretch">
                                                <ContentControl
                                                    Content="{x:Bind}"
                                                    ContentTemplate="{StaticResource LocalNotificationItemTemplate}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch" />
                                                <Rectangle
                                                    Height="1"
                                                    Margin="0,7,0,0"
                                                    Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                                                    HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ContentControl>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                FontSize="24"
                FontWeight="SemiBold"
                Text="本机通知历史" />
            <Button
                Grid.Column="1"
                Padding="8,4"
                Background="Transparent"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Command="{Binding ViewModel.ClearAllCommand, ElementName=PageRoot}"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                    <TextBlock Text="清除所有" FontSize="13" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater
                ItemsSource="{x:Bind ViewModel.GroupedLocalNotifications, Mode=OneWay}"
                ItemTemplate="{StaticResource GroupedNotificationTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="10" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <ProgressRing
            Grid.Row="1"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </Grid>

</Page>
