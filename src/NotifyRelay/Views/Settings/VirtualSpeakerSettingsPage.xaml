<Page
    x:Class="NotifyRelay.Views.Settings.VirtualSpeakerSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NotifyRelay.Helpers"
    xmlns:items="using:NotifyRelay.Data.Items"
    xmlns:local="using:NotifyRelay.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.DataContext>
        <local:VirtualSpeakerViewModel />
    </Page.DataContext>

    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">
            <BreadcrumbBar x:Name="BreadcrumbBar" Margin="0,0,0,8">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="items:BreadcrumbBarItemModel">
                        <BreadcrumbBarItem AutomationProperties.Name="{Binding Name}" Content="{Binding}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <wuc:SettingsCard Header="音频中继" Description="通过 Rust 核心直接中继 PCM 音频">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE995;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock
                            x:Name="StatusTextBlock"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="发送本端音频到对端" Description="将本机系统音频通过中继发送到远端设备播放">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;" />
                </wuc:SettingsCard.HeaderIcon>
                <Button
                    x:Name="StartSendButton"
                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                    Click="StartSendButton_Click"
                    Content="发送音频" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="接收对端音频并播放" Description="请求远端设备发送音频到本机播放">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B0;" />
                </wuc:SettingsCard.HeaderIcon>
                <Button
                    x:Name="StartRecvButton"
                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                    Click="StartRecvButton_Click"
                    Content="接收音频" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="停止音频转发" Description="停止当前音频中继转发">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74F;" />
                </wuc:SettingsCard.HeaderIcon>
                <Button
                    x:Name="StopButton"
                    IsEnabled="{x:Bind ViewModel.IsActive, Mode=OneWay}"
                    Click="StopButton_Click"
                    Content="停止" />
            </wuc:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
