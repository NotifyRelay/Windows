<Page
    x:Class="NotifyRelay.Views.Settings.OverlayLogiBatteryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NotifyRelay.Models.Render"
    xmlns:viewmodels="using:NotifyRelay.ViewModels.Settings"
    xmlns:converters="using:NotifyRelay.Converters"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 与主页同款：统一调用共享 BatteryIconUtility，避免分段逻辑漂移 -->
        <converters:LogiBatteryStatusToBrushConverter x:Key="LogiBatteryStatusToBrushConverter" />
        <converters:LogiBatteryStatusToGlyphConverter x:Key="LogiBatteryStatusToGlyphConverter" />
        <converters:LogiBatteryTextConverter x:Key="LogiBatteryTextConverter" />
    </Page.Resources>

    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">

            <TextBlock Text="设备与预览" FontSize="20" FontWeight="SemiBold" />

            <wuc:SettingsExpander Header="罗技设备列表" Description="检测当前已配对/在线的罗技接收器与无线设备的电池状态" IsExpanded="True">
                <wuc:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE855;" />
                </wuc:SettingsExpander.HeaderIcon>
                <wuc:SettingsExpander.Items>
                    <wuc:SettingsCard ContentAlignment="Left">
                        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RefreshButton" Click="RefreshButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                        <TextBlock Text="立即刷新" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.StatusHint, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}" BorderThickness="1"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LogiBatteryDeviceInfo">
                                        <Grid Height="44" Padding="16,0,16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 电池图标（主页同款字体 + 共享颜色分段） -->
                                            <FontIcon Grid.Column="0" FontSize="20"
                                                      Glyph="{x:Bind Converter={StaticResource LogiBatteryStatusToGlyphConverter}, Mode=OneWay}"
                                                      Foreground="{x:Bind Converter={StaticResource LogiBatteryStatusToBrushConverter}, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                            <!-- 在线指示点 -->
                                            <Ellipse Grid.Column="1" Width="10" Height="10"
                                                     Fill="{x:Bind Online, Mode=OneWay, Converter={StaticResource LogiBatteryStatusToBrushConverter}}"
                                                     VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <!-- 设备名 -->
                                            <TextBlock Grid.Column="2" Text="{x:Bind DeviceName, Mode=OneWay}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <!-- 充电状态文本 -->
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind IsCharging, Mode=OneWay, Converter={StaticResource LogiBatteryTextConverter}}" />
                                            </TextBlock>
                                            <!-- 电量百分比 -->
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" TextAlignment="Right"
                                                       Foreground="{x:Bind Converter={StaticResource LogiBatteryStatusToBrushConverter}, Mode=OneWay}">
                                                <Run Text="{x:Bind BatteryPercent, Mode=OneWay, Converter={StaticResource LogiBatteryTextConverter}}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="数据来源：logi-battery 子模块导出的 Rust FFI (logi_battery.dll)。检测范围：HID++ 1.0/2.0 直连与接收器配对设备。"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </wuc:SettingsCard>
                </wuc:SettingsExpander.Items>
            </wuc:SettingsExpander>

            <TextBlock Text="覆盖层显示" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />

            <wuc:SettingsCard Header="在覆盖层显示罗技电池" Description="在主屏（或指定屏幕）叠加层显示设备卡片（图标 + 名称 + 电量%）">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE855;" />
                </wuc:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.LogiBatteryEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="设备离线时隐藏" Description="未上线设备不渲染；关闭则依然显示占位状态（默认开启）">
                <ToggleSwitch IsOn="{x:Bind ViewModel.HideWhenDisconnected, Mode=TwoWay}" OnContent="" OffContent="" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="显示大小" Description="整体卡片缩放（0.5-4 倍）">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE1A1;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider Minimum="0.5" Maximum="4" StepFrequency="0.1" Width="240"
                            Value="{x:Bind ViewModel.Scale, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Scale, Mode=OneWay}"
                               VerticalAlignment="Center" Width="36"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </wuc:SettingsCard>

            <TextBlock Text="位置" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />

            <wuc:SettingsCard Header="显示屏幕" Description="所选屏幕找不到时回退到主屏（默认仅主屏幕）">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </wuc:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ScreenCombo"
                          ItemsSource="{x:Bind ViewModel.Screens}"
                          SelectionChanged="ScreenCombo_SelectionChanged"
                          MinWidth="220" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="水平位置 (X)" Description="0-100%，相对所选屏幕宽度">
                <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.XPercent, Mode=TwoWay}" Width="240" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="垂直位置 (Y)" Description="0-100%，相对所选屏幕高度">
                <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.YPercent, Mode=TwoWay}" Width="240" />
            </wuc:SettingsCard>

            <TextBlock Text="电池图标与颜色分段逻辑与主页『设备电池』字体图标完全一致（共享 BatteryIconUtility）。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,0" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</Page>
