<Page
    x:Class="NotifyRelay.Views.Settings.OverlayDeepSeekBalancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:NotifyRelay.ViewModels.Settings"
    xmlns:worker="using:NotifyRelay.Worker.Services"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">

            <TextBlock Text="余额监控" FontSize="20" FontWeight="SemiBold" />

            <wuc:SettingsCard Header="DeepSeek 余额监控" Description="{x:Bind ViewModel.CurrentBalanceText, Mode=OneWay}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8BC;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="MonitorStatusTextBlock"
                               FontSize="14"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    <ToggleSwitch x:Name="MonitorToggle"
                                  IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                                  OnContent="开启（同时显示在覆盖层）"
                                  OffContent="关闭" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="API Token" Description="DeepSeek API Token 用于查询余额">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PasswordBox x:Name="TokenPasswordBox" Width="280"
                                 Password="{x:Bind ViewModel.ApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="保存" Click="SaveToken_Click" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="查询间隔" Description="自动查询余额的时间间隔">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;" />
                </wuc:SettingsCard.HeaderIcon>
                <ComboBox x:Name="IntervalComboBox" MinWidth="140"
                          SelectedIndex="{x:Bind ViewModel.SelectedIntervalIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="每秒" Tag="1000" />
                    <ComboBoxItem Content="每分钟" Tag="60000" />
                    <ComboBoxItem Content="每半小时" Tag="1800000" />
                    <ComboBoxItem Content="每天" Tag="86400000" />
                </ComboBox>
            </wuc:SettingsCard>

            <wuc:SettingsCard>
                <wuc:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" />
                        <TextBlock Text="操作" />
                    </StackPanel>
                </wuc:SettingsCard.Header>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="立即查询" Click="FetchNow_Click" />
                    <Button Content="清除历史" Click="ClearHistory_Click" />
                </StackPanel>
            </wuc:SettingsCard>

            <TextBlock Text="覆盖层显示" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />

            <wuc:SettingsCard Header="显示大小" Description="余额卡片整体缩放（0.5-4 倍）">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE1A1;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider Minimum="0.5" Maximum="4" StepFrequency="0.1" Width="240"
                            Value="{x:Bind ViewModel.Scale, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Scale, Mode=OneWay}"
                               VerticalAlignment="Center" Width="36"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </wuc:SettingsCard>

            <TextBlock Text="位置" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />

            <wuc:SettingsCard Header="显示屏幕" Description="所选屏幕找不到时回退到主屏（默认仅主屏幕）">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </wuc:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ScreenCombo"
                          ItemsSource="{x:Bind ViewModel.Screens}"
                          SelectionChanged="ScreenCombo_SelectionChanged"
                          MinWidth="220" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="水平位置 (X)" Description="0-100%，相对所选屏幕宽度">
                <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.XPercent, Mode=TwoWay}" Width="240" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="垂直位置 (Y)" Description="0-100%，相对所选屏幕高度">
                <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.YPercent, Mode=TwoWay}" Width="240" />
            </wuc:SettingsCard>

            <TextBlock Text="余额卡片在覆盖层以图标 + 余额 + 变化量显示（涨绿跌红），不遮挡鼠标操作。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,0" TextWrapping="Wrap" />

            <TextBlock Text="历史余额记录" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />

            <wuc:SettingsCard Header="历史余额记录" Description="{x:Bind ViewModel.HistoryCountText, Mode=OneWay}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8EF;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Margin="0,4" Text="折叠显示" />
                        <ToggleSwitch x:Name="CollapseToggle" IsOn="{x:Bind ViewModel.IsCollapsed, Mode=TwoWay}" OnContent="是" OffContent="否" />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="HistoryListView" ItemsSource="{x:Bind ViewModel.DisplayHistory, Mode=OneWay}" IsItemClickEnabled="False" SelectionMode="None">
                            <ListView.Header>
                                <Grid Background="{ThemeResource SystemBaseLowColor}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="时间" Padding="8,4" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="余额 (CNY)" Padding="8,4" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="变化" Padding="8,4" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="类型" Padding="8,4" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="数量" Padding="8,4" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="worker:BalanceHistoryItem">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Padding="8,4" FontSize="12">
                                            <Run Text="{Binding Time}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Padding="8,4" FontSize="12">
                                            <Run Text="¥" />
                                            <Run Text="{Binding Balance}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Padding="8,4" FontSize="12">
                                            <Run Text="{Binding Change}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding ChangeType}" Padding="8,4" FontSize="12" />
                                        <TextBlock Grid.Column="4" Padding="8,4" FontSize="12">
                                            <Run Text="{Binding MergeCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </StackPanel>
            </wuc:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
