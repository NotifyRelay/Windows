<Page
    x:Class="NotifyRelay.Views.Settings.OverlayClockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewmodels="using:NotifyRelay.ViewModels.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">

            <wuc:SettingsCard Header="显示时间浮窗" Description="在覆盖层显示自由浮动的时间，无背景、仅字体描边">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE121;" />
                </wuc:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ClockOverlayEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
            </wuc:SettingsCard>

            <TextBlock Text="显示" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />

            <wuc:SettingsCard Header="文本颜色">
                <Button x:Name="ColorPickerButton" Width="40" Height="40" CornerRadius="8"
                        Background="{x:Bind ViewModel.ClockColor, Mode=OneWay}" Click="ColorPickerButton_Click" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="文本描边" Description="字体描边粗细（像素），描边为文本颜色的反色；0 为不描边">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE934;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider Minimum="0.1" Maximum="3" StepFrequency="0.1" Width="240"
                            Value="{x:Bind ViewModel.ClockTextOutlineWidth, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ClockTextOutlineWidth, Mode=OneWay}"
                               VerticalAlignment="Center" Width="36"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="显示大小" Description="整体显示缩放（文本与描边按比例缩放）">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE1A1;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider Minimum="0.5" Maximum="2" StepFrequency="0.1" Width="240"
                            Value="{x:Bind ViewModel.ClockScale, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ClockScale, Mode=OneWay}"
                               VerticalAlignment="Center" Width="36"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="显示秒" Description="在时分后显示秒数">
                <ToggleSwitch IsOn="{x:Bind ViewModel.ClockShowSeconds, Mode=TwoWay}" OnContent="" OffContent="" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="24 小时制" Description="关闭则使用 12 小时制并显示上午/下午">
                <ToggleSwitch IsOn="{x:Bind ViewModel.ClockUse24Hour, Mode=TwoWay}" OnContent="" OffContent="" />
            </wuc:SettingsCard>

            <TextBlock Text="位置" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />

            <wuc:SettingsCard Header="显示屏幕" Description="时间浮窗显示在所选屏幕；找不到时回退到主屏">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </wuc:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ScreenCombo"
                          ItemsSource="{x:Bind ViewModel.Screens}"
                          SelectionChanged="ScreenCombo_SelectionChanged"
                          MinWidth="220" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="水平位置 (X)" Description="0-100%，相对所选屏幕宽度">
                <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.XPercent, Mode=TwoWay}" Width="240" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="垂直位置 (Y)" Description="0-100%，相对所选屏幕高度">
                <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.YPercent, Mode=TwoWay}" Width="240" />
            </wuc:SettingsCard>

            <TextBlock Text="时间浮窗以所设位置为中心自由浮动，无背景仅描边，不遮挡鼠标操作。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,0" TextWrapping="Wrap" />

            <ContentDialog x:Name="ColorPickerDialog" Title="选择颜色" PrimaryButtonText="确定" SecondaryButtonText="取消" PrimaryButtonClick="ColorPickerDialog_PrimaryButtonClick">
                <StackPanel>
                    <ColorPicker x:Name="ColorPicker" IsAlphaEnabled="False" />
                </StackPanel>
            </ContentDialog>

        </StackPanel>
    </ScrollViewer>
</Page>
