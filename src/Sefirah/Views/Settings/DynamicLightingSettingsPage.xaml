<Page
    x:Class="NotifyRelay.Views.Settings.DynamicLightingSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NotifyRelay.Helpers"
    xmlns:items="using:NotifyRelay.Data.Items"
    xmlns:local="using:NotifyRelay.Views.Settings"
    xmlns:models="using:NotifyRelay.Data.Models"
    xmlns:converters="using:NotifyRelay.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:LampArrayKindToGlyphConverter x:Key="LampArrayKindToGlyphConverter" />
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter" />
        <converters:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter" />
        <converters:DoubleToPercentConverter x:Key="DoubleToPercentConverter" />
        <converters:ColorToStringConverter x:Key="ColorToStringConverter" />
    </Page.Resources>

    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">
            <BreadcrumbBar x:Name="BreadcrumbBar" Margin="0,0,0,8">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="items:BreadcrumbBarItemModel">
                        <BreadcrumbBarItem AutomationProperties.Name="{Binding Name}" Content="{Binding}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Name}" />
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <wuc:SettingsCard Header="动态光效" Description="{x:Bind ViewModel.DeviceCountText, Mode=OneWay}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE739;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" FontSize="14" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Grid.Column="0" />
                        <ToggleSwitch x:Name="EnableToggle" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" OnContent="" OffContent="" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="已连接设备" Description="{x:Bind ViewModel.DeviceListDescription, Mode=OneWay}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE725;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="4">
                    <ListView x:Name="DeviceListView" ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}" IsItemClickEnabled="False" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LampArrayDeviceInfo">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind Kind, Mode=OneWay, Converter={StaticResource LampArrayKindToGlyphConverter}}" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LampCount, Mode=OneWay}" FontSize="12" Foreground="Gray" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind IsAvailable, Mode=OneWay, Converter={StaticResource BoolToStatusConverter}}" FontSize="12" Foreground="{x:Bind IsAvailable, Mode=OneWay, Converter={StaticResource BoolToStatusColorConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoDevicesText" Text="未检测到支持动态光效的设备" Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}" FontSize="14" Foreground="Gray" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="亮度" Description="{x:Bind ViewModel.BrightnessText, Mode=OneWay}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D6;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="4">
                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="1" Value="{x:Bind ViewModel.Brightness, Mode=TwoWay}" StepFrequency="0.01" />
                    <TextBlock Text="{Binding ElementName=BrightnessSlider, Path=Value, Converter={StaticResource DoubleToPercentConverter}}" HorizontalAlignment="Right" FontSize="12" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="静态颜色">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE791;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Rectangle x:Name="ColorPreview" Width="40" Height="40" Fill="{x:Bind ViewModel.CurrentColorBrush, Mode=OneWay}" Stroke="Black" StrokeThickness="1" />
                    <Button x:Name="ColorPickerButton" Content="选择颜色" Click="ColorPickerButton_Click" />
                    <Button x:Name="TurnOffButton" Content="关闭灯光" Click="TurnOffButton_Click" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="预设效果">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE771;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="4">
                    <ComboBox x:Name="EffectComboBox" SelectedIndex="{x:Bind ViewModel.SelectedEffectIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="无" Tag="None" />
                        <ComboBoxItem Content="彩虹循环" Tag="Rainbow" />
                        <ComboBoxItem Content="闪烁" Tag="Blink" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StartEffectButton" Content="开始效果" Click="StartEffectButton_Click" />
                        <Button x:Name="StopEffectButton" Content="停止效果" Click="StopEffectButton_Click" />
                    </StackPanel>
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="AutoRGB 模式" Description="{x:Bind ViewModel.AutoRGBStatusText, Mode=OneWay}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE708;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="跟随屏幕颜色变化" Grid.Column="0" />
                        <ToggleSwitch x:Name="AutoRGBToggle" IsOn="{x:Bind ViewModel.IsAutoRGBEnabled, Mode=TwoWay}" OnContent="" OffContent="" Grid.Column="1" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="当前捕获颜色:" />
                        <Rectangle Width="32" Height="32" Fill="{x:Bind ViewModel.CurrentCapturedColorBrush, Mode=OneWay}" Stroke="Black" StrokeThickness="1" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{x:Bind ViewModel.CurrentCapturedColor, Mode=OneWay, Converter={StaticResource ColorToStringConverter}}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="更新间隔" FontSize="12" />
                        <ComboBox x:Name="AutoRGBIntervalComboBox" SelectedIndex="{x:Bind ViewModel.SelectedIntervalIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="快速 (50ms)" Tag="50" />
                            <ComboBoxItem Content="正常 (100ms)" Tag="100" />
                            <ComboBoxItem Content="慢速 (200ms)" Tag="200" />
                            <ComboBoxItem Content="省电 (500ms)" Tag="500" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="CaptureSupportText" Text="{x:Bind ViewModel.CaptureSupportText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind ViewModel.IsCaptureSupported, Mode=OneWay, Converter={StaticResource BoolToStatusColorConverter}}" />
                </StackPanel>
            </wuc:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>