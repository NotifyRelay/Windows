<Page
    x:Class="NotifyRelay.Views.Settings.WallpaperOverlaySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NotifyRelay.Helpers"
    xmlns:items="using:NotifyRelay.Data.Items"
    xmlns:local="using:NotifyRelay.Views.Settings"
    xmlns:viewmodels="using:NotifyRelay.ViewModels.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToStatusConverter x:Key="BoolToStatusConverter" />
        <local:IntToStringConverter x:Key="IntToStringConverter" />
    </Page.Resources>

    <Page.DataContext>
        <viewmodels:WallpaperOverlayViewModel />
    </Page.DataContext>

    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">
            <BreadcrumbBar x:Name="BreadcrumbBar" Margin="0,0,0,8">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="items:BreadcrumbBarItemModel">
                        <BreadcrumbBarItem AutomationProperties.Name="{Binding Name}" Content="{Binding}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Name}" />
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <wuc:SettingsCard Header="壁纸层显示" Description="将内容显示到壁纸层，不遮蔽桌面图标">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F0;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock
                            x:Name="StatusTextBlock"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Bind ViewModel.IsEnabled, Mode=OneWay, Converter={StaticResource BoolToStatusConverter}}"
                            Grid.Column="0" />
                        <ToggleSwitch
                            x:Name="EnableToggle"
                            IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="显示文本" Description="设置要显示在壁纸层上的文本内容（支持Markdown）">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </wuc:SettingsCard.HeaderIcon>
            </wuc:SettingsCard>

            <Grid Height="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox
                            x:Name="MarkdownEditor"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            PlaceholderText="输入Markdown文本..."
                            TextChanged="MarkdownEditor_TextChanged" />
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="#40000000">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <TextBlock
                            x:Name="MarkdownPreview"
                            TextWrapping="Wrap"
                            VerticalAlignment="Stretch" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <wuc:SettingsCard Header="字体大小" Description="设置显示文本的字体大小">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D5;" />
                </wuc:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="FontSizeComboBox"
                    MinWidth="100"
                    SelectedItem="{x:Bind ViewModel.FontSize, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                    ItemsSource="{x:Bind ViewModel.FontSizeOptions, Mode=OneWay}" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="文字颜色" Description="设置显示文本的颜色">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE791;" />
                </wuc:SettingsCard.HeaderIcon>
                <Button
                    x:Name="ColorPickerButton"
                    Width="40"
                    Height="40"
                    CornerRadius="8"
                    Background="{x:Bind ViewModel.TextColor, Mode=OneWay}"
                    Click="ColorPickerButton_Click" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="文本对齐" Description="设置文本的对齐方式">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE891;" />
                </wuc:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="TextAlignmentComboBox"
                    MinWidth="100"
                    SelectedItem="{x:Bind ViewModel.TextAlignment, Mode=TwoWay}"
                    ItemsSource="{x:Bind ViewModel.TextAlignmentOptions, Mode=OneWay}" />
            </wuc:SettingsCard>

            <ContentDialog x:Name="ColorPickerDialog" Title="选择颜色" PrimaryButtonText="确定" SecondaryButtonText="取消" PrimaryButtonClick="ColorPickerDialog_PrimaryButtonClick">
                <StackPanel>
                    <ColorPicker x:Name="ColorPicker" IsAlphaEnabled="False" />
                </StackPanel>
            </ContentDialog>

            <wuc:SettingsCard Header="窗口位置与大小" Description="在壁纸层窗口上拖动调整位置和大小，会自动保存">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE739;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="预览" Click="PreviewButton_Click" />
                    <Button Content="隐藏" Click="HideButton_Click" />
                </StackPanel>
            </wuc:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>