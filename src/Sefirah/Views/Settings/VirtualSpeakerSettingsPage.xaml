<Page
    x:Class="NotifyRelay.Views.Settings.VirtualSpeakerSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NotifyRelay.Helpers"
    xmlns:items="using:NotifyRelay.Data.Items"
    xmlns:local="using:NotifyRelay.Views.Settings"
    xmlns:dev="using:NotifyRelay.DeviceCtrl.VirtualSpeaker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.DataContext>
        <local:VirtualSpeakerViewModel />
    </Page.DataContext>

    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">
            <BreadcrumbBar x:Name="BreadcrumbBar" Margin="0,0,0,8">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="items:BreadcrumbBarItemModel">
                        <BreadcrumbBarItem AutomationProperties.Name="{Binding Name}" Content="{Binding}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <wuc:SettingsCard Header="扫描SoundSeeder设备" Description="{x:Bind ViewModel.DiscoveryStatus, Mode=OneWay}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE995;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8" Orientation="Horizontal">
                    <Button x:Name="ScanButton" Click="ScanButton_Click" Content="开始扫描" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="选择目标设备" Description="选择SoundSeeder音频接收设备">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B0;" />
                </wuc:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="DeviceComboBox"
                    Width="240"
                    HorizontalAlignment="Left"
                    ItemsSource="{x:Bind ViewModel.AvailableSpeakers, Mode=OneWay}"
                    DisplayMemberPath="Name"
                    SelectedValuePath="Uuid"
                    SelectedValue="{x:Bind ViewModel.SelectedDeviceId, Mode=TwoWay}"
                    PlaceholderText="选择SoundSeeder设备" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="启用虚拟扬声器" Description="{helpers:ResourceString Name=VirtualSpeaker/EnableDescription}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock
                            x:Name="StatusTextBlock"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="状态：未启动"
                            Grid.Column="0" />
                        <ToggleSwitch
                            x:Name="EnableToggle"
                            IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="启动时静音系统声音" Description="{helpers:ResourceString Name=VirtualSpeaker/MuteOnStartDescription}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74F;" />
                </wuc:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.MuteOnStart, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="流式策略" Description="切换调试不同发包策略">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B0;" />
                </wuc:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="StrategyComboBox"
                    Width="280"
                    HorizontalAlignment="Left"
                    SelectedIndex="{x:Bind ViewModel.SelectedStrategyIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="原始逐包 (PerCallback)"/>
                    <ComboBoxItem Content="积累200ms + timestamp=0 (AccumZero200)"/>
                    <ComboBoxItem Content="积累500ms + timestamp=0 (AccumZero500)"/>
                    <ComboBoxItem Content="积累1000ms + timestamp=0 (AccumZero1000)"/>
                    <ComboBoxItem Content="积累200ms + 正常timestamp (AccumTrue200)"/>
                    <ComboBoxItem Content="积累200ms + 正常timestamp+buffer (AccumBuf200)"/>
                    <ComboBoxItem Content="模仿官方 ~23ms逐包 + 正常timestamp (Official)"/>
                </ComboBox>
            </wuc:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
