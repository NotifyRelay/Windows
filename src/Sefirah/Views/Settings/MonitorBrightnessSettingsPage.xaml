<Page
    x:Class="NotifyRelay.Views.Settings.MonitorBrightnessSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NotifyRelay.Helpers"
    xmlns:items="using:NotifyRelay.Data.Items"
    xmlns:local="using:NotifyRelay.Views.Settings"
    xmlns:dev="using:NotifyRelay.DeviceCtrl.MonitorBrightness"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.DataContext>
        <local:MonitorBrightnessViewModel />
    </Page.DataContext>

    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">
            <!--  Breadcrumb Navigation  -->
            <BreadcrumbBar x:Name="BreadcrumbBar" Margin="0,0,0,8">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="items:BreadcrumbBarItemModel">
                        <BreadcrumbBarItem AutomationProperties.Name="{Binding Name}" Content="{Binding}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <!--  ControlMyMonitor Path  -->
            <wuc:SettingsCard Header="ControlMyMonitor" Description="{x:Bind ViewModel.ControlMyMonitorPath, Mode=OneTime}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </wuc:SettingsCard.HeaderIcon>
                <Button x:Name="BrowseButton" Click="BrowseButton_Click" Content="{helpers:ResourceString Name=SelectLocation}" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="下载地址" Description="https://www.nirsoft.net/utils/control_my_monitor.html">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </wuc:SettingsCard.HeaderIcon>
                <HyperlinkButton
                    Content="打开下载页面"
                    NavigateUri="https://www.nirsoft.net/utils/control_my_monitor.html"
                    Foreground="{ThemeResource HyperlinkForeground}" />
            </wuc:SettingsCard>

            <!--  Sync Status and Control  -->
            <wuc:SettingsCard Header="显示器亮度同步" Description="启动后将监控系统亮度变化并同步到外接显示器">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock
                            x:Name="SyncStatusTextBlock"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="状态：未启动"
                            Grid.Column="0" />
                        <ToggleSwitch
                            x:Name="SyncToggle"
                            IsOn="{x:Bind ViewModel.SyncEnabled, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </wuc:SettingsCard>

            <!--  Monitor Selection  -->
            <wuc:SettingsCard Header="选择显示器" Description="选择需要同步亮度的显示器">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F0;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <Button x:Name="MonitorsDropdownButton" HorizontalAlignment="Left" Width="240">
                        <Button.Flyout>
                            <Flyout x:Name="MonitorsFlyout" Opened="MonitorsFlyout_Opened">
                                <ScrollViewer MaxHeight="200">
                                    <ItemsControl x:Name="MonitorsItemsControl" ItemsSource="{x:Bind ViewModel.AvailableMonitors, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="dev:MonitorInfo">
                                                <CheckBox Content="{x:Bind Name}" Tag="{x:Bind Id}" Checked="MonitorCheckBox_Checked" Unchecked="MonitorCheckBox_Unchecked"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </wuc:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
