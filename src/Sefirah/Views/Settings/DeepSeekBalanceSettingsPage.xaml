<Page
    x:Class="NotifyRelay.Views.Settings.DeepSeekBalanceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NotifyRelay.Helpers"
    xmlns:items="using:NotifyRelay.Data.Items"
    xmlns:local="using:NotifyRelay.Views.Settings"
    xmlns:dev="using:NotifyRelay.DeviceCtrl.DeepSeekBalance"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.DataContext>
        <local:DeepSeekBalanceViewModel />
    </Page.DataContext>

    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">
            <BreadcrumbBar x:Name="BreadcrumbBar" Margin="0,0,0,8">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="items:BreadcrumbBarItemModel">
                        <BreadcrumbBarItem AutomationProperties.Name="{Binding Name}" Content="{Binding}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Name}" />
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <wuc:SettingsCard Header="DeepSeek 余额监控" Description="{x:Bind ViewModel.CurrentBalanceText, Mode=OneWay}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8BC;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="MonitorStatusTextBlock" VerticalAlignment="Center" FontSize="14" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Grid.Column="0" />
                        <ToggleSwitch x:Name="MonitorToggle" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" OnContent="" OffContent="" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="API Token" Description="DeepSeek API Token 用于查询余额">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </wuc:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PasswordBox x:Name="TokenPasswordBox" Width="280" Password="{x:Bind ViewModel.ApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="保存" Click="SaveToken_Click" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="查询间隔" Description="自动查询余额的时间间隔">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;" />
                </wuc:SettingsCard.HeaderIcon>
                <ComboBox x:Name="IntervalComboBox" MinWidth="140" SelectedIndex="{x:Bind ViewModel.SelectedIntervalIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="每秒" Tag="1000" />
                    <ComboBoxItem Content="每分钟" Tag="60000" />
                    <ComboBoxItem Content="每半小时" Tag="1800000" />
                    <ComboBoxItem Content="每天" Tag="86400000" />
                </ComboBox>
            </wuc:SettingsCard>

            <wuc:SettingsCard>
                <wuc:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" />
                        <TextBlock Text="操作" />
                    </StackPanel>
                </wuc:SettingsCard.Header>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="立即查询" Click="FetchNow_Click" />
                    <Button Content="清除历史" Click="ClearHistory_Click" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="历史余额记录" Description="{x:Bind ViewModel.HistoryCountText, Mode=OneWay}">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8EF;" />
                </wuc:SettingsCard.HeaderIcon>
                <ScrollViewer Margin="0,10,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <ListView x:Name="HistoryListView" ItemsSource="{x:Bind ViewModel.BalanceHistory, Mode=OneWay}" IsItemClickEnabled="False" SelectionMode="None">
                        <ListView.Header>
                            <Grid Background="{ThemeResource SystemBaseLowColor}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="时间" Padding="8,4" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="余额 (CNY)" Padding="8,4" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="变化" Padding="8,4" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="类型" Padding="8,4" FontSize="12" FontWeight="SemiBold" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dev:BalanceHistoryItem">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Padding="8,4" FontSize="12">
                                        <Run Text="{Binding Time}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Padding="8,4" FontSize="12">
                                        <Run Text="¥" />
                                        <Run Text="{Binding Balance}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Padding="8,4" FontSize="12">
                                        <Run Text="{Binding Change}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Text="{Binding ChangeType}" Padding="8,4" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </wuc:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
