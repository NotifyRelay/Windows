<Page
    x:Class="NotifyRelay.Views.Settings.DanmakuSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NotifyRelay.Helpers"
    xmlns:items="using:NotifyRelay.Data.Items"
    xmlns:local="using:NotifyRelay.Views.Settings"
    xmlns:viewmodels="using:NotifyRelay.ViewModels.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewmodels:DanmakuViewModel />
    </Page.DataContext>

    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">
            <BreadcrumbBar x:Name="BreadcrumbBar" Margin="0,0,0,8">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="items:BreadcrumbBarItemModel">
                        <BreadcrumbBarItem AutomationProperties.Name="{Binding Name}" Content="{Binding}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Name}" />
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <wuc:SettingsCard Header="通知弹幕" Description="在桌面叠加层显示通知弹幕">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F0;" />
                </wuc:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DanmakuNotificationEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="媒体卡片" Description="在叠加层顶部显示当前播放的媒体信息">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D6;" />
                </wuc:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DanmakuMediaCardEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="SuperIsland卡片" Description="在叠加层顶部显示 SuperIsland 卡片">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE718;" />
                </wuc:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DanmakuSuperIslandEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="强制Gamebar转发" Description="启用后同时转发到 Gamebar（不受优先级影响）">
                <wuc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </wuc:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.GamebarRelayEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
            </wuc:SettingsCard>

            <TextBlock Text="弹幕样式" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />

            <wuc:SettingsCard Header="字体大小" Description="50-300%，基数 36pt">
                <Slider Minimum="50" Maximum="300" Value="{x:Bind ViewModel.DanmakuFontSizePercent, Mode=TwoWay}" Width="200" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="速度" Description="1-20">
                <Slider Minimum="1" Maximum="20" Value="{x:Bind ViewModel.DanmakuSpeed, Mode=TwoWay}" Width="200" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="不透明度" Description="10-100%">
                <Slider Minimum="10" Maximum="100" Value="{x:Bind ViewModel.DanmakuOpacityPercent, Mode=TwoWay}" Width="200" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="显示区域" Description="10-100%">
                <Slider Minimum="10" Maximum="100" Value="{x:Bind ViewModel.DanmakuDisplayAreaPercent, Mode=TwoWay}" Width="200" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="密度">
                <ComboBox SelectedIndex="{x:Bind ViewModel.DanmakuDensity, Mode=TwoWay}" MinWidth="120">
                    <x:String>正常</x:String>
                    <x:String>更多</x:String>
                    <x:String>重叠</x:String>
                </ComboBox>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="字体">
                <ComboBox Text="{x:Bind ViewModel.DanmakuFontFamily, Mode=TwoWay}" IsEditable="True" MinWidth="120" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="加粗">
                <ToggleSwitch IsOn="{x:Bind ViewModel.DanmakuBold, Mode=TwoWay}" OnContent="" OffContent="" />
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="弹幕颜色">
                <Button x:Name="ColorPickerButton" Width="40" Height="40" CornerRadius="8"
                        Background="{x:Bind ViewModel.DanmakuColor, Mode=OneWay}" Click="ColorPickerButton_Click" />
            </wuc:SettingsCard>

            <TextBlock Text="装饰" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />

            <wuc:SettingsCard Header="描边">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.DanmakuBorderEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
                    <Button x:Name="BorderColorButton" Width="32" Height="32" CornerRadius="4"
                            Background="{x:Bind ViewModel.DanmakuBorderColor, Mode=OneWay}" Click="BorderColorButton_Click" />
                    <Slider Minimum="0" Maximum="8" Value="{x:Bind ViewModel.DanmakuBorderThickness, Mode=TwoWay}" Width="100" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="阴影">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.DanmakuShadowEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
                    <Button x:Name="ShadowColorButton" Width="32" Height="32" CornerRadius="4"
                            Background="{x:Bind ViewModel.DanmakuShadowColor, Mode=OneWay}" Click="ShadowColorButton_Click" />
                    <Slider Minimum="0" Maximum="16" Value="{x:Bind ViewModel.DanmakuShadowDepth, Mode=TwoWay}" Width="100" ToolTipService.ToolTip="深度" />
                    <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.DanmakuShadowOpacity, Mode=TwoWay}" Width="100" ToolTipService.ToolTip="不透明度" />
                </StackPanel>
            </wuc:SettingsCard>

            <wuc:SettingsCard Header="操作">
                <Button Content="发送测试弹幕" Click="TestDanmakuButton_Click" />
            </wuc:SettingsCard>

            <ContentDialog x:Name="ColorPickerDialog" Title="选择颜色" PrimaryButtonText="确定" SecondaryButtonText="取消" PrimaryButtonClick="ColorPickerDialog_PrimaryButtonClick">
                <StackPanel>
                    <ColorPicker x:Name="ColorPicker" IsAlphaEnabled="False" />
                </StackPanel>
            </ContentDialog>

        </StackPanel>
    </ScrollViewer>
</Page>
