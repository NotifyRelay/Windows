<Page
    x:Class="NotifyRelay.Views.LocalNotificationHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NotifyRelay.Data.Models"
    xmlns:vm="using:NotifyRelay.ViewModels"
    xmlns:converters="using:NotifyRelay.Converters"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Inverse="True" />

        <DataTemplate x:Key="LocalNotificationTemplate" x:DataType="models:Notification">
            <Grid
                Margin="20,8,20,8"
                Padding="12"
                Background="Transparent"
                CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    CornerRadius="20">
                    <Image
                        Width="40"
                        Height="40"
                        Source="{x:Bind Icon, Mode=OneWay}"
                        Stretch="Fill" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontWeight="SemiBold"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind AppName}" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind TimeStamp}" />
                    </Grid>
                    <TextBlock
                        Margin="0,2,0,0"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ShouldShowTitle, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        MaxLines="3"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Text}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="24"
            FontWeight="SemiBold"
            Text="本机通知历史" />

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater
                ItemsSource="{x:Bind ViewModel.LocalNotifications, Mode=OneWay}"
                ItemTemplate="{StaticResource LocalNotificationTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <ProgressRing
            Grid.Row="1"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </Grid>

</Page>
