<UserControl
    x:Class="Sefirah.UserControls.NotificationsListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Sefirah.Converters"
    xmlns:helpers="using:Sefirah.Helpers"
    xmlns:local="using:Sefirah.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Sefirah.Data.Models"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:viewmodels="using:Sefirah.ViewModels"
    xmlns:wctconverters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="utu"
    x:Name="UserControlRoot">

    <UserControl.Resources>
        <wctconverters:BoolToObjectConverter x:Key="BoolToPinTextConverter"
            FalseValue="{helpers:ResourceString Name=Pin}"
            TrueValue="{helpers:ResourceString Name=Unpin}" />
        
        <wctconverters:BoolToObjectConverter x:Key="BoolToPinGlyphConverter" FalseValue="&#xE718;" TrueValue="&#xE77A;" />
        <wctconverters:BoolToObjectConverter x:Key="BoolToCollapseGlyphConverter" FalseValue="&#xE71D;" TrueValue="&#xE90A;" />
        <wctconverters:BoolNegationConverter x:Key="BoolNegationConverter" />

        <converters:DateTimeConverter x:Key="DateTimeConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Inverse="True" />
        <converters:EmptyObjectToVisibilityConverter x:Key="EmptyObjectToVisibilityConverter" />
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
    </UserControl.Resources>

    <Grid
        Margin="18,10,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Notifications Heading  -->
            <TextBlock
                Grid.Column="0"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{helpers:ResourceString Name=Notifications}" />

            <!--  Clear All Button  -->
            <Button
                Grid.Column="1"
                Margin="0,0,20,0"
                Padding="10,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Command="{x:Bind ViewModel.ClearAllNotificationallCommand}"
                Content="{helpers:ResourceString Name=NotificationsClearButton}"
                FontSize="14" />
        </Grid>
        <!-- 音乐媒体块（支持显示来自多个设备的媒体块） -->
        <ItemsRepeater
            Grid.Row="1"
            Margin="0,10,0,0"
            ItemsSource="{x:Bind ViewModel.CurrentMusicMediaBlocks, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="models:MusicMediaBlock">
                    <Border
                        Padding="10"
                        Margin="0,0,0,8"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 音乐封面 -->
                            <Image
                                Grid.Column="0"
                                Width="100"
                                Height="100"
                                VerticalAlignment="Top"
                                Source="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                            <!-- 音乐信息 -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Spacing="5">
                                <!-- 音乐标题 -->
                                <TextBlock
                                    FontWeight="SemiBold"
                                    FontSize="18"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <!-- 艺术家和专辑 -->
                                <TextBlock
                                    Foreground="Gray"
                                    FontSize="14"
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <!-- 设备名称 -->
                                <TextBlock
                                    Foreground="Gray"
                                    FontSize="12"
                                    Text="{x:Bind DeviceName, Mode=OneWay}" />
                                 
                                <!-- 媒体控制按钮 -->
                            <StackPanel
                                Orientation="Horizontal"
                                Margin="0,10,0,0"
                                Spacing="10">
                                <Button
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Command="{Binding ViewModel.SendMediaControlCommand, ElementName=UserControlRoot}"
                                    CommandParameter="{x:Bind PreviousCommandParameter, Mode=OneWay}"
                                    CornerRadius="18">
                                    <FontIcon Glyph="&#xE76B;" />
                                </Button>
                                <Button
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Command="{Binding ViewModel.SendMediaControlCommand, ElementName=UserControlRoot}"
                                    CommandParameter="{x:Bind PlayPauseCommandParameter, Mode=OneWay}"
                                    CornerRadius="18">
                                    <FontIcon Glyph="&#xE102;" />
                                </Button>
                                <Button
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Command="{Binding ViewModel.SendMediaControlCommand, ElementName=UserControlRoot}"
                                    CommandParameter="{x:Bind NextCommandParameter, Mode=OneWay}"
                                    CornerRadius="18">
                                    <FontIcon Glyph="&#xE76C;" />
                                </Button>
                            </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        
        <!-- 分组通知列表 -->
        <ScrollViewer
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="0,0,20,0"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.GroupedNotifications, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:GroupedNotification">
                        <Border
                            Padding="0"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <!-- 分组标题栏 -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- 折叠/展开按钮 -->
                                <Button
                                    Grid.Row="0"
                                    Padding="10"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="ToggleGroupCollapse"
                                    Tag="{x:Bind}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 折叠/展开图标 -->
                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="{x:Bind IsCollapsed, Converter={StaticResource BoolToCollapseGlyphConverter}, Mode=OneWay}"
                                            VerticalAlignment="Center" />
                                        <!-- 应用图标 -->
                                        <Image
                                            Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            VerticalAlignment="Center"
                                            Source="{x:Bind Icon, Mode=OneWay}" />
                                        <!-- 应用名称和通知数量 -->
                                        <StackPanel
                                            Grid.Column="2"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Text="{x:Bind DisplayApp}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="Gray"
                                                Text="{x:Bind NotificationCountText, Mode=OneWay}" />
                                        </StackPanel>
                                        <!-- 最早通知时间 -->
                                        <TextBlock
                                            Grid.Column="3"
                                            FontSize="12"
                                            Foreground="Gray"
                                            HorizontalAlignment="Right"
                                            Text="{x:Bind FormattedEarliestTime, Mode=OneWay}" />
                                        <!-- 清除该应用所有通知按钮 -->
                                        <Button
                                            Grid.Column="4"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ViewModel.ClearAllNotificationsCommand, ElementName=UserControlRoot}"
                                            CommandParameter="{x:Bind AppPackage}"
                                            ToolTipService.ToolTip="清除该应用所有通知">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Button>
                                <!-- 分隔线 -->
                                <Rectangle
                                    Grid.Row="0"
                                    Height="1"
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                                    Visibility="{x:Bind IsCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" />
                                <!-- 分组通知内容 -->
                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,0,0,0"
                                    Visibility="{x:Bind IsCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                                    <!-- 通知列表 -->
                                    <ItemsRepeater ItemsSource="{x:Bind Notifications}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="7" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:Notification">
                                                <Border
                                                    Padding="10"
                                                    Margin="0,0,0,0"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    PointerEntered="OnPointerEntered"
                                                    PointerExited="OnPointerExited">
                                                    <Grid RowSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" MaxHeight="500" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Spacing="5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel
                                                                    Grid.Column="0"
                                                                    Orientation="Horizontal"
                                                                    Spacing="5">
                                                                    <TextBlock
                                                                        FontSize="13"
                                                                        FontWeight="Medium"
                                                                        Text="{x:Bind Title}" />
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        Foreground="Gray"
                                                                        Text="{x:Bind SourceDevices[0].DeviceName}" />
                                                                </StackPanel>
                                                                <StackPanel
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                Spacing="5">
                                                                    <Button
                                                                        x:Name="PinButton"
                                                                        Width="24"
                                                                        Height="24"
                                                                        Margin="0,0,0,0"
                                                                        Padding="4"
                                                                        Background="Transparent"
                                                                        BorderBrush="Transparent"
                                                                        Click="ToggleNotificationPinClick"
                                                                        DataContext="{x:Bind}"
                                                                        IsHitTestVisible="False"
                                                                        Opacity="0">
                                                                        <FontIcon Glyph="{x:Bind Pinned, Converter={StaticResource BoolToPinGlyphConverter}}" FontSize="14" />
                                                                        <ToolTipService.ToolTip>
                                                                            <ToolTip Content="{x:Bind Pinned, Converter={StaticResource BoolToPinTextConverter}}" />
                                                                        </ToolTipService.ToolTip>
                                                                    </Button>
                                                                    <Button
                                                                                    x:Name="CloseButton"
                                                                                    Width="24"
                                                                                    Height="24"
                                                                                    Margin="0,0,0,0"
                                                                                    Padding="4"
                                                                                    Command="{Binding ViewModel.RemoveNotificationCommand, ElementName=UserControlRoot}"
                                                                                    CommandParameter="{x:Bind}"
                                                                                    IsHitTestVisible="False"
                                                                                    Opacity="0"
                                                                                    Style="{StaticResource AlternateCloseButtonStyle}" />
                                                                    <SymbolIcon
                                                                        x:Name="PinIcon"
                                                                        RenderTransformOrigin="0.5,0.5"
                                                                        Symbol="Pin"
                                                                        Tag="{x:Bind Pinned}"
                                                                        Visibility="{x:Bind Pinned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <SymbolIcon.RenderTransform>
                                                                            <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                                                                        </SymbolIcon.RenderTransform>
                                                                    </SymbolIcon>
                                                                    <TextBlock
                                                                        x:Name="TimeStampTextBlock"
                                                                        Margin="0,0,0,0"
                                                                        Foreground="Gray"
                                                                        HorizontalTextAlignment="End"
                                                                        Text="{x:Bind TimeStamp, Converter={StaticResource DateTimeConverter}}"
                                                                        Visibility="Visible" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <!--  Display Text if GroupedMessages is empty  -->
                                                            <TextBlock
                                                                x:Name="FallbackTextBlock"
                                                                x:Load="{x:Bind HasGroupedMessages, Converter={StaticResource BoolNegationConverter}}"
                                                                Foreground="Gray"
                                                                IsTextSelectionEnabled="True"
                                                                Text="{x:Bind Text}"
                                                                TextWrapping="Wrap" />
                                                            <!--  Display GroupedMessages if not empty  -->
                                                            <ItemsRepeater
                                                                x:Name="GroupedMessagesRepeater"
                                                                HorizontalAlignment="Stretch"
                                                                x:Load="{x:Bind HasGroupedMessages}"
                                                                ItemsSource="{x:Bind GroupedMessages}">
                                                                <ItemsRepeater.Layout>
                                                                    <StackLayout Orientation="Vertical" Spacing="5" />
                                                                </ItemsRepeater.Layout>
                                                                <ItemsRepeater.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:NotificationGroup">
                                                                        <StackPanel>
                                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Sender}" />
                                                                            <ItemsRepeater ItemsSource="{x:Bind Messages}">
                                                                                <ItemsRepeater.Layout>
                                                                                    <StackLayout Orientation="Vertical" Spacing="2" />
                                                                                </ItemsRepeater.Layout>
                                                                                <ItemsRepeater.ItemTemplate>
                                                                                    <DataTemplate x:DataType="x:String">
                                                                                        <TextBlock
                                                                                            Foreground="Gray"
                                                                                            IsTextSelectionEnabled="True"
                                                                                            Text="{x:Bind}"
                                                                                            TextWrapping="Wrap" />
                                                                                    </DataTemplate>
                                                                                </ItemsRepeater.ItemTemplate>
                                                                            </ItemsRepeater>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsRepeater.ItemTemplate>
                                                            </ItemsRepeater>
                                                            
                                                            <!--  设备按钮列表，显示通知的所有来源设备  -->
                                                            <ItemsRepeater
                                                                x:Name="DeviceButtonsRepeater"
                                                                Margin="0,5,0,0"
                                                                HorizontalAlignment="Left"
                                                                ItemsSource="{x:Bind SourceDevices}"
                                                                Tag="{x:Bind}"
                                                                ElementPrepared="DeviceButtonsRepeater_ElementPrepared">
                                                                <ItemsRepeater.Layout>
                                                                    <StackLayout Orientation="Horizontal" Spacing="5" />
                                                                </ItemsRepeater.Layout>
                                                                <ItemsRepeater.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:SourceDevice">
                                                                        <Button
                                                                            Padding="8,3"
                                                                            Background="Transparent"
                                                                            BorderBrush="Gray"
                                                                            BorderThickness="1"
                                                                            Click="OpenAppClick"
                                                                            Tag="{x:Bind}"
                                                                            CornerRadius="4"
                                                                            FontSize="12"
                                                                            ToolTipService.ToolTip="在应用程序中打开">
                                                                            <TextBlock
                                                                                Text="{x:Bind DeviceName}"
                                                                                TextWrapping="NoWrap" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsRepeater.ItemTemplate>
                                                            </ItemsRepeater>
                                                        </StackPanel>
                                                        <StackPanel
                                                            x:Name="ActionsPanel"
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Stretch"
                                                            Spacing="7">
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
